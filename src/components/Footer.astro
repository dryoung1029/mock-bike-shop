---
import { site } from '../../site.config';
interface Props {
  hideCta?: boolean;
}
const { hideCta = false } = Astro.props;
const year = new Date().getFullYear();
const socialLabels: Record<string, string> = { tiktok: 'TikTok', youtube: 'YouTube' };
const socials = Object.entries(site.social).filter(([, url]) => url) as [string, string][];
const days = Object.entries(site.hours) as [string, string][];
---

{!hideCta && (
  <section class="section section--dark">
    <div class="container center">
      <h2>Bike making a funny noise?</h2>
      <p class="lede" style="color: var(--fg-on-dark)">
        Bring it in. We'll tell you what it needs and what it costs before we touch a thing.
      </p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary btn--lg" href={site.primaryCta.href}>{site.primaryCta.label}</a>
        <a class="btn btn--ghost" href="/contact/">Ask a question first</a>
      </div>
    </div>
  </section>
)}

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <img src="/brand/logo.svg" alt={site.name} width="180" height="49" class="footer-logo" />
      <p class="muted">{site.shortPitch}</p>
      {socials.length > 0 && (
        <ul class="social">
          {socials.map(([name, url]) => (
            <li>
              <a href={url} rel="me noopener" target="_blank">{socialLabels[name] ?? name.charAt(0).toUpperCase() + name.slice(1)}</a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div>
      <h3>Visit</h3>
      <address>
        {site.address.street}<br />
        {site.address.city}, {site.address.region} {site.address.postalCode}<br />
        <span class="muted">{site.address.landmark}</span><br />
        {site.address.mapsUrl && <><a href={site.address.mapsUrl} target="_blank" rel="noopener">Get directions</a><br /></>}
        <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>

    <div>
      <h3>Hours</h3>
      {site.hoursConfirmed ? (
        <ul class="hours">
          {days.map(([day, h]) => (
            <li>
              <span>{day}</span>
              <span>{h || 'Closed'}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">Call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a> for hours.</p>
      )}
    </div>

    <div>
      <h3>Explore</h3>
      <ul class="footer-links">
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/book-service/">Book a service</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <small class="muted">© {year} {site.name}. All rights reserved.</small>
    <small><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></small>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--s3) var(--s1);
    background: var(--bg-alt);
  }
  .footer-grid {
    display: grid;
    gap: var(--s2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .footer-logo {
    width: 180px;
    background: #fff;
    border-radius: 6px;
    padding: 2px 6px;
    margin-bottom: var(--s0);
  }
  .site-footer h3 {
    font-size: var(--step-0);
    margin-bottom: var(--s-1);
  }
  address {
    font-style: normal;
    line-height: 1.7;
  }
  .hours,
  .footer-links,
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--s0);
    border-bottom: 1px dotted var(--line-strong);
    padding: 0.15em 0;
  }
  .footer-links li,
  .social li {
    padding: 0.15em 0;
  }
  .social {
    display: flex;
    gap: var(--s0);
    flex-wrap: wrap;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s0);
    margin-top: var(--s2);
    padding-top: var(--s0);
    border-top: 1px solid var(--line);
  }
</style>
