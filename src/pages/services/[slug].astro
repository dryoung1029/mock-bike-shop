---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import { getServices, type Service } from '../../lib/content';
import { crumbs, faqJsonLd } from '../../lib/seo';
import { site, bookingHref } from '../../../site.config';
import { pack } from '../../lib/pack';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const d = service.data;
const { Content } = await render(service);

const items = [
  { name: 'Services', url: '/services/' },
  { name: d.name, url: `/services/${service.id}/` },
];
const faqs = d.faqs.map((f) => ({ question: f.q, answer: f.a }));
const serviceNode = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.name,
  serviceType: 'Bicycle repair',
  description: d.seoDescription ?? d.tagline,
  provider: { '@id': `${pack.brand.siteUrl}/#organization` },
  areaServed: `${site.address.city}, ${site.address.region}`,
  url: `${pack.brand.siteUrl}/services/${service.id}/`,
  ...(d.price ? { offers: { '@type': 'Offer', priceCurrency: 'USD', description: d.price } } : {}),
};
const jsonLd = [crumbs(items), serviceNode, faqJsonLd(faqs)].filter(Boolean) as Record<string, unknown>[];
---

<BaseLayout title={d.seoTitle ? `${d.seoTitle} in ${site.address.city}, ${site.address.region}` : `${d.name} in ${site.address.city}, ${site.address.region}`} description={d.seoDescription ?? d.tagline} jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs items={items} />
    <header class="program-head">
      <h1>{d.name}</h1>
      <p class="lede">{d.tagline}</p>
      <dl class="facts">
        <div><dt>Good for</dt><dd>{d.audience}</dd></div>
        {d.turnaround && <div><dt>Turnaround</dt><dd>{d.turnaround}</dd></div>}
        {d.price && <div><dt>Price</dt><dd>{d.price}</dd></div>}
      </dl>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href={bookingHref()}>{d.bookingLabel}</a>
        <a class="btn btn--ghost" href="/contact/">Ask a question</a>
      </div>
    </header>

    <div class="split">
      <article class="prose">
        <Content />
      </article>
      <aside>
        {faqs.length > 0 && (
          <>
            <h2 style="font-size: var(--step-1)">Common questions</h2>
            <FaqList faqs={faqs} />
          </>
        )}
        <div class="notice" style="margin-top: var(--s1)">
          <strong>Where:</strong> {site.address.street}, {site.address.city}. {site.address.landmark}.<br />
          <a href="/pricing/">See the full price list</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .program-head {
    padding-block: var(--s1) var(--s2);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s2);
  }
  .program-head h1 {
    font-size: var(--step-3);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s0) var(--s2);
    margin: var(--s0) 0 var(--s1);
  }
  .facts dt {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--fg-muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 700;
  }
</style>
