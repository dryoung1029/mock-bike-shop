---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceList from '../../components/ServiceList.astro';
import { getServices } from '../../lib/content';
import { crumbs } from '../../lib/seo';
import { site, bookingHref } from '../../../site.config';

const services = await getServices();
const items = [{ name: 'Services', url: '/services/' }];
---

<BaseLayout
  title="Bike Repair Services — Tune-Ups, Flats, Overhauls, Fitting, E-Bikes"
  description={`Bike services at ${site.name} in ${site.address.city}: tune-ups, flat tire repair, full overhauls, wheel truing and building, bike fitting, and e-bike service.`}
  jsonLd={[crumbs(items)]}
>
  <div class="container">
    <Breadcrumbs items={items} />
    <PageHeader
      title="Services"
      lede="Every job starts the same way: we look at the bike, tell you what it needs, and give you a price before we pick up a wrench."
    />
    <ServiceList services={services} />
    <section class="section">
      <h2>Not sure what your bike needs?</h2>
      <p>Bring it in and describe what's going on. We'll check it over and tell you honestly — even if the answer is "just some air in the tires."</p>
      <a class="btn btn--primary" href={bookingHref()}>Book a service</a>
    </section>
  </div>
</BaseLayout>
