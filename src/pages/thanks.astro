---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../../site.config';
---

<BaseLayout title="Thanks — we got your message" description={`Your message reached ${site.name}.`} robots="noindex,nofollow">
  <div class="container" style="padding-block: var(--s3); max-width: var(--measure)">
    <h1>Got it. We'll be in touch soon.</h1>
    <p class="lede">Someone from the shop will get back to you.</p>
    <p>In a hurry? Call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>, or just bring the bike by — walk-ins are welcome.</p>
    <a class="btn btn--primary" href="/services/">See our services</a>
  </div>
</BaseLayout>
