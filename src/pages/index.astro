---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceList from '../components/ServiceList.astro';
import FaqList from '../components/FaqList.astro';
import { site, bookingHref } from '../../site.config';
import { getServices, getFaqsFor, getPublishedArticles, formatDate } from '../lib/content';
import { faqJsonLd } from '../lib/seo';

const services = await getServices();
const faqs = await getFaqsFor('home');
const recent = (await getPublishedArticles()).slice(0, 3);
const jsonLd = [faqJsonLd(faqs.map((f) => f.data))].filter(Boolean) as Record<string, unknown>[];
const town = `${site.address.city}, ${site.address.region}`;

const title = `Bike Repair & Tune-Ups in ${town}`;
const description = `${site.name} is a neighborhood bike shop in ${town}: tune-ups, flat repair, overhauls, wheel truing, bike fitting, and e-bike service. Clear prices, and we call before adding anything.`;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__where">{town}</p>
        <h1>Bring it in rattling. Ride it out smooth.</h1>
        <p class="lede">
          Tune-ups, flat fixes, wheel work, fittings, and e-bike service from mechanics who explain what they're doing and why.
          Clear prices up front. No surprises on the bill.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={bookingHref()}>Book a service</a>
          <a class="btn btn--ghost" href="/services/">See our services</a>
        </div>
        <p class="hero__note muted">Walk-ins welcome. Flat fixes are usually done while you wait.</p>
      </div>
      {site.heroPhoto.src && (
        <div class="hero__photo">
          <img src={site.heroPhoto.src} alt={site.heroPhoto.alt} width="1200" height="900" fetchpriority="high" />
        </div>
      )}
    </div>
  </section>

  <section class="section section--tight">
    <div class="container pillars">
      <div>
        <h2>Prices before work</h2>
        <p>You get a price when you drop off. If we find something else, we call or text first. Nothing is added without your yes.</p>
      </div>
      <div>
        <h2>Every kind of bike</h2>
        <p>Road, gravel, mountain, commuter, cargo, kids' bikes, and most e-bikes. If it has pedals, bring it by.</p>
      </div>
      <div>
        <h2>No judgment</h2>
        <p>Department-store bike or carbon race machine, first ride or ten-thousandth: you'll get the same straight answers.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2>What we do</h2>
        <p>From a five-minute flat fix to a full rebuild. Every service starts with a look at the bike and an honest estimate.</p>
      </div>
      <ServiceList services={services} />
      <p style="margin-top: var(--s1)"><a href="/pricing/">See the full price list</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>How a repair works</h2>
        <ol class="steps">
          <li>
            <h3>Drop it off</h3>
            <p>Come by during open hours or book ahead. Tell us what's going on — noises, feelings, and "it just seems off" all count.</p>
          </li>
          <li>
            <h3>Get a price</h3>
            <p>We look the bike over and give you an estimate and a pickup day before any work starts.</p>
          </li>
          <li>
            <h3>Ride away</h3>
            <p>We let you know when it's ready, walk you through what we did, and point out anything to keep an eye on.</p>
          </li>
        </ol>
        <a class="btn btn--primary" href={bookingHref()}>Book a service</a>
      </div>
      <div class="quote-block">
        <blockquote>
          <p>
            We opened {site.name} to be the shop we always wanted to walk into: straight answers, fair prices, and mechanics who are happy to show you how to fix a flat yourself.
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split">
      <div>
        <h2>Questions? We have answers.</h2>
        <FaqList faqs={faqs} />
        <p style="margin-top: var(--s1)"><a href="/faq/">More questions and answers</a></p>
      </div>
      <div>
        <h2>Find us</h2>
        <p>
          <strong>{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}</strong><br />
          {site.address.landmark}.
        </p>
        <p>
          {site.address.mapsUrl && <><a href={site.address.mapsUrl} target="_blank" rel="noopener">Get directions</a> ·{' '}</>}
          <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
        </p>
        {site.address.mapsEmbedUrl && (
          <iframe
            src={site.address.mapsEmbedUrl}
            width="100%"
            height="280"
            style="border:0; border-radius: var(--radius-lg)"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Map to ${site.name}`}
          ></iframe>
        )}
      </div>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>From the repair stand</h2>
          <p>Plain-language answers to the questions we hear across the counter.</p>
        </div>
        <ul class="post-list">
          {recent.map((a) => (
            <li>
              <h3><a href={`/blog/${a.id}/`}>{a.data.title}</a></h3>
              <p class="muted">{a.data.excerpt}</p>
              <small class="muted">{formatDate(a.data.publishDate)}</small>
            </li>
          ))}
        </ul>
        <p style="margin-top: var(--s1)"><a href="/blog/">All articles</a></p>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-block: var(--s3);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    gap: var(--s2);
    align-items: center;
  }
  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .hero__photo img {
    border-radius: var(--radius-lg);
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
  .hero__where {
    font-weight: 800;
    color: var(--blue);
    margin-bottom: var(--s-1);
  }
  .hero h1 {
    max-width: 14ch;
  }
  .hero__note {
    margin-top: var(--s0);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .pillars {
    display: grid;
    gap: var(--s1);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .pillars h2 {
    font-size: var(--step-1);
  }
  .pillars p {
    color: var(--fg-muted);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s1);
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s0);
    padding: var(--s0) 0;
    border-top: 1px solid var(--line);
  }
  .steps li::before {
    content: counter(step);
    font-weight: 800;
    font-size: var(--step-2);
    color: var(--blue);
    line-height: 1;
  }
  .steps h3 {
    font-size: var(--step-1);
    margin-bottom: 0.2em;
  }
  .steps p {
    margin: 0;
    color: var(--fg-muted);
  }
  .quote-block blockquote {
    margin: 0;
    padding: var(--s1);
    background: var(--blue-tint);
    border-radius: var(--radius-lg);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.5;
  }
  .quote-block footer {
    margin-top: var(--s0);
    font-size: var(--step--1);
    color: var(--fg-muted);
    font-weight: 700;
  }
</style>
