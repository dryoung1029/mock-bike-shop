---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import { site, bookingHref } from '../../site.config';
import { getFaqsFor } from '../lib/content';
import { crumbs, faqJsonLd } from '../lib/seo';

const faqs = await getFaqsFor('pricing');
const items = [{ name: 'Pricing', url: '/pricing/' }];
const jsonLd = [crumbs(items), faqJsonLd(faqs.map((f) => f.data))].filter(Boolean) as Record<string, unknown>[];
---

<BaseLayout
  title="Bike Repair Prices"
  description={`${site.name} repair prices in ${site.address.city}: tune-ups, overhauls, flat repair, wheel truing, bike fitting, and e-bike check-ups. Labor prices up front; we quote parts before installing them.`}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={items} />
    <PageHeader
      title="Pricing"
      lede="Prices below are for labor. Parts are extra, and we always tell you the cost before we install anything."
    />

    <div class="grid grid--3">
      {site.pricing.map((p) => (
        <div class={`card ${p.featured ? 'card--featured' : ''}`}>
          {p.note && <p class="tag">{p.note}</p>}
          <h2 style="font-size: var(--step-1)">{p.name}</h2>
          <p class="price">{p.price} <small>{p.period}</small></p>
        </div>
      ))}
    </div>

    <section class="section--tight" style="margin-top: var(--s2)">
      <h2>Not on the list?</h2>
      <p>
        Most other jobs — brake bleeds, cable swaps, installing parts you bought elsewhere — are priced by the job.
        Tell us what you need and we'll give you a number before we start. See all <a href="/services/">services</a>.
      </p>
      <a class="btn btn--primary" href={bookingHref()}>Book a service</a>
    </section>

    <section class="section--tight">
      <h2>Questions about pricing</h2>
      <FaqList faqs={faqs} />
    </section>
  </div>
</BaseLayout>
