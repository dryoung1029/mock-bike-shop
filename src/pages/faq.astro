---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import { getFaqsFor } from '../lib/content';
import { crumbs, faqJsonLd } from '../lib/seo';
import { site, bookingHref } from '../../site.config';

const faqs = await getFaqsFor('faq');
const items = [{ name: 'FAQ', url: '/faq/' }];
const jsonLd = [crumbs(items), faqJsonLd(faqs.map((f) => f.data))].filter(Boolean) as Record<string, unknown>[];
---

<BaseLayout
  title="Frequently Asked Questions"
  description={`Answers to common questions about ${site.name} in ${site.address.city}: appointments, turnaround times, what prices include, what bikes we work on, and more.`}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={items} />
    <PageHeader title="Questions? We have answers." lede="Still curious after this? Call, email, or stop by the shop and ask in person." />
    <div style="max-width: var(--measure)">
      <FaqList faqs={faqs} />
    </div>
    <p style="margin-top: var(--s2)"><a class="btn btn--primary" href={bookingHref()}>Book a service</a></p>
  </div>
</BaseLayout>
