---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist. Here's where to go instead." robots="noindex,nofollow">
  <div class="container" style="padding-block: var(--s3)">
    <h1>That page moved or never existed.</h1>
    <p class="lede">The shop is still here, though.</p>
    <ul>
      <li><a href="/services/">Services</a></li>
      <li><a href="/pricing/">Pricing</a></li>
      <li><a href="/book-service/">Book a service</a></li>
      <li><a href="/contact/">Contact us</a></li>
    </ul>
  </div>
</BaseLayout>
