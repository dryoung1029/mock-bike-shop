---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { crumbs } from '../lib/seo';
import { site, bookingHref } from '../../site.config';
const items = [{ name: 'About', url: '/about/' }];
---

<BaseLayout
  title={`About ${site.name}`}
  description={`${site.name} is a neighborhood bike shop in ${site.address.city} built on a simple idea: straight answers, fair prices, and bikes that ride like new.`}
  jsonLd={[crumbs(items)]}
>
  <div class="container">
    <Breadcrumbs items={items} />
    <PageHeader title="A bike shop that tells you the truth." />
    <div class="prose">
      <!-- SETUP: Jason tells the origin story in the wizard (why he opened the shop, when, what he wanted to do differently). The text below is SAMPLE: demo copy. -->
      <p>{site.name} exists because getting your bike fixed shouldn't feel like a mystery. You should know what's wrong, what it costs, and whether it's worth doing — before anyone picks up a wrench.</p>
      <h2>What we're built on</h2>
      <ul>
        <li><strong>Straight answers.</strong> If your bike needs air and not a new drivetrain, we'll tell you.</li>
        <li><strong>Prices before work.</strong> An estimate up front, and a call before anything gets added.</li>
        <li><strong>Every rider welcome.</strong> Kids' bikes, commuter bikes, e-bikes, and race bikes all get the same care.</li>
      </ul>
      <h2>What that looks like at the counter</h2>
      <p>We show you what we found. We explain it in plain words. And if it's something you can fix yourself next time, we're happy to show you how.</p>
      <h2>Who runs it</h2>
      <p>{site.name} is owned by <a href="/team/#jason">Jason</a>, who is usually at the repair stand. Meet the rest of the <a href="/team/">team</a>.</p>
      <p><a class="btn btn--primary" href={bookingHref()}>Book a service</a></p>
    </div>
  </div>
</BaseLayout>
